{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "crime-network-frontend",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8010"
      ],
      "port": 8010
    },
    {
      "name": "nexus-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 4310
    },
    {
      "name": "nexus-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "start:preview"
      ],
      "port": 4311
    }
  ]
}